# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# The deployed/running frontend URL (used for CORS).
# Local dev default: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# The Gmail/email address that should receive contact form submissions.
CONTACT_RECEIVER_EMAIL=YOUR_GMAIL_ADDRESS

# SMTP configuration used to send the contact form email.
# For Gmail: host=smtp.gmail.com, port=587, username=your Gmail address,
# password = a 16-character Gmail "App Password" (NOT your normal password).
# Docs: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Basic anti-spam rate limiting for POST /api/contact
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
