# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# The deployed/running frontend URL (used for CORS).
# Local dev default: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# The Gmail/email address that should receive contact form submissions.
CONTACT_RECEIVER_EMAIL=YOUR_GMAIL_ADDRESS

# ---------------------------------------------------------------------------
# Resend email configuration
# ---------------------------------------------------------------------------

# Resend API key.
# NEVER commit the real API key.
RESEND_API_KEY=

# Sender email used by Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Basic anti-spam rate limiting for POST /api/contact
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
