# ---------------------------------------------------------------------------
# Frontend environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Backend API base URL
# Local dev: http://127.0.0.1:8000
# Production: your deployed Render URL, e.g. https://portfolio-name.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Resume link (must open in a new tab). Add your resume PDF URL here.
VITE_RESUME_URL=/Mayank_Singh_Negi_Resume.pdf

# Social links
VITE_GITHUB_URL=https://github.com/mayanksnegi
VITE_LINKEDIN_URL=https://linkedin.com/in/mayanksnegi

# Contact email shown/used on the site (optional; leave blank if unknown)
VITE_CONTACT_EMAIL=try.mayanknegi@gmail.com
